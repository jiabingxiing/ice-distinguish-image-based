# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml
*.so
.pyd

# ---- 实验产物：统一写 artifacts/，不入库 ----
artifacts/
runs/
wandb/
lightning_logs/
*.onnx
*.engine
*.pt
*.pth
*.ckpt
*.joblib
*.npz

# ---- 数据：只保留目录骨架与 README ----
data/raw/*
data/external/*
data/interim/*
data/processed/*
!data/**/.gitkeep
!data/**/README.md
data/manifests/*.jsonl

# 划分索引属「可复现契约」：由 scripts/build_scut_manifest.py 确定性生成
# （固定 seed=42），体量小且必须入库，用于锁定 Monitor-Holdout 终端集合。
!data/splits/*.jsonl

# CatBoost 训练临时目录（默认在 cwd 生成，不应入库）
catboost_info/

# ---- 密钥与本地配置 ----
.env
.env.*
!.env.example
*.local.yaml
secrets/

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
